# Copy to .env and fill in. Never commit .env.
# OpenSky API client (free account -> Account page -> API client). Leave empty for anonymous access (400 credits/day).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Seconds between captures. 300 = every 5 minutes (about 1,150 of the 4,000 daily credits for the India box).
CAPTURE_SECONDS=300
POSTGRES_PASSWORD=skystream
